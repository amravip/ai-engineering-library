---
import { bookBySlug, coverUrl, fullCoverUrl } from '../lib/books.js';

const { slug } = Astro.props;
const book = bookBySlug(slug);
const cover = fullCoverUrl(slug);
const outcomesHeading = book.number === 1 ? 'What you will learn' : 'Planned learning outcomes';
---

<div class="book-landing">
  {cover && (
    <div class="book-landing-cover">
      <img src={cover} alt={`Cover of ${book.title}, by Ravi Pal`} width="1600" height="2560" decoding="async" />
    </div>
  )}
  <div class="book-landing-text">
    {book.subtitle && <p class="book-subtitle">{book.subtitle}</p>}
    <p class="book-meta">
      Volume {book.number} · Project: {book.project} · Industry: {book.industry} · Level: {book.difficulty}
    </p>
    <p class="book-lead">{book.description}</p>
    <h2>{outcomesHeading}</h2>
    <ul>
      {book.outcomes.map((outcome) => <li>{outcome}</li>)}
    </ul>
    {!book.online && <p class="book-status">In preparation.</p>}
  </div>
</div>
