{
  "name": "ai-engineering-library-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Reader website for the AI Engineering Library by Ravi Pal",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
